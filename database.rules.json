{
  "rules": {
    "produtos": {
      ".read": true,
      ".write": "auth != null",
      ".indexOn": ["ativo"]
    },
    "pedidos": {
      ".read": "auth != null",
      ".indexOn": ["leva", "criadoEm"],
      "$pid": {
        ".write": "auth != null || (!data.exists() && newData.exists())",
        ".validate": "newData.hasChildren(['nome','whatsapp','leva','diaEntrega','itens','totalPaes'])"
      }
    },
    "config": {
      ".read": true,
      ".write": "auth != null"
    }
  }
}
